APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Analytics 4 (vacío = desactivado). Reemplaza G-XXXXXXXXXX por tu ID de medición de GA4.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Sync productos: hard delete de artículos que ya no vienen en la API externa
# CHERRY_SYNC_PRUNE_ORPHANS=true
# CHERRY_SYNC_PRUNE_MIN_API_RATIO=0.8

# Catálogo: URL base que ve el navegador (mismo origen, proxy en routes/web). Por defecto el front usa /cherry-api/789/articulos
# VITE_CHERRY_CATALOG_BASE_URL=/cherry-api/789/articulos
# Aguas arriba del proxy (Laravel, artisan sync). Sin barra final.
# CHERRY_CATALOG_API_UPSTREAM=https://cherryapi.estrategiadmgs.com.mx/cherryApi

# API externa de clientes (GET {base}/DM00001) — descuentos informativos en admin
# CHERRY_CLIENTE_API_BASE=https://cherryapi.estrategiadmgs.com.mx/cherryApi/789/cliente

# Cherry — correos y enlaces públicos (confirmación de pedido)
# false = no envía pedidos a la API externa de ventas (pruebas sin tocar producción)
CHERRY_EXTERNAL_SALES_API_ENABLED=true

CHERRY_ORDERS_WEB_URL=https://cherrydev.789.com.mx
CHERRY_MAIL_LOGO_URL=
CHERRY_MAIL_ORDER_CONFIRMATION_HERO_URL=
CHERRY_SOCIAL_FACEBOOK_URL=
CHERRY_SOCIAL_INSTAGRAM_URL=
CHERRY_SOCIAL_WHATSAPP_URL=
CHERRY_RETURNS_POLICY_URL=

# Respond.io Website Chat (pega el ID del snippet o la URL .js completa del panel)
RESPOND_IO_ENABLED=true
RESPOND_IO_CHANNEL_ID=YOUR_RESPOND_IO_CHANNEL_ID
# RESPOND_IO_WIDGET_SCRIPT_URL=https://cdn.respond.io/webchat/widget/tu-id.js
# Growth tool (snippet widget.js?wId=...) en todas las vistas que cargan app.blade.php
RESPOND_IO_GROWTH_TOOL_ENABLED=true
RESPOND_IO_GROWTH_TOOL_WID=fef1dbec-7474-4fcb-8761-a89344af5ff1

# Token Bearer para el webhook de búsqueda de productos (Respond.io workflows)
RESPONDIO_SECRET_TOKEN=
