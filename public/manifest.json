{
  "name": "Cherry App - Moda y Accesorios",
  "short_name": "Cherry",
  "description": "Tu tienda de moda y accesorios favorita. Encuentra las últimas tendencias en ropa, calzado y más.",
  "start_url": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#ffffff",
  "theme_color": "#E91E63",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "es-MX",
  "dir": "ltr",
  "categories": ["shopping", "fashion", "lifestyle"],
  "prefer_related_applications": false,
  "related_applications": [],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "protocol_handlers": [
    {
      "protocol": "web+cherry",
      "url": "/?cherry=%s"
    }
  ],
  "icons": [
    {
      "src": "/images/logo.svg",
      "sizes": "72x72",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/images/logo.svg",
      "sizes": "96x96",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/images/logo.svg",
      "sizes": "128x128",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/images/logo.svg",
      "sizes": "144x144",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/images/logo.svg",
      "sizes": "152x152",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/images/logo.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/images/logo.svg",
      "sizes": "384x384",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/images/logo.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/images/logo.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Productos Nuevos",
      "short_name": "Nuevos",
      "description": "Ver productos nuevos y tendencias",
      "url": "/nuevos",
      "icons": [
        {
          "src": "/images/logo.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Categorías",
      "short_name": "Categorías",
      "description": "Explorar todas las categorías",
      "url": "/categorias",
      "icons": [
        {
          "src": "/images/logo.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Carrito de Compras",
      "short_name": "Carrito",
      "description": "Ver y gestionar carrito",
      "url": "/carrito-detalle",
      "icons": [
        {
          "src": "/images/logo.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Mi Perfil",
      "short_name": "Perfil",
      "description": "Gestionar cuenta y pedidos",
      "url": "/perfil",
      "icons": [
        {
          "src": "/images/logo.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "image/*": [".jpg", ".jpeg", ".png", ".webp"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
