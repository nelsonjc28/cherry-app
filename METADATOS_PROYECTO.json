  "comentarios_relevantes_ia": [
    "Producto.id es string, no integer",
    "Stock se calcula sumando inventario_d de Detalle",
    "Productos 'próximamente' tienen fecha_alta null O (stock_received_count = 0 AND inventario <= 0)",
    "Productos 'nuevos' tienen fecha_alta dentro de 30 días O opc_nuevo = 'S'",
    "Usuarios 'oro' pueden hacer encargos de productos 'próximamente'",
    "Carrito se persiste en BD, no solo localStorage",
    "Ofertas pueden ser: porcentaje, buy_x_get_y, order_discount, free_shipping",
    "NUNCA modificar migraciones existentes, crear nuevas",
    "SIEMPRE validar inputs en backend",
    "Mantener estructura de respuesta JSON consistente"
  ],
