{
  "proyecto": {
    "nombre": "Cherry App",
    "tipo": "E-commerce Platform",
    "descripcion": "Plataforma de e-commerce para gestión de productos, pedidos, catálogos y pagos con integración MercadoPago",
    "version": "1.0.0"
  },
  "stack_tecnologico": {
    "backend": {
      "framework": "Laravel",
      "version": "12.0",
      "lenguaje": "PHP",
      "version_php": "8.2+",
      "orm": "Eloquent",
      "autenticacion": "JWT (tymon/jwt-auth)",
      "base_datos": "MySQL"
    },
    "frontend": {
      "framework": "React",
      "version": "19.1.0",
      "router": "React Router DOM 7.6.3",
      "estado_global": "Zustand 5.0.6",
      "build_tool": "Vite 6.2.4",
      "estilos": "Tailwind CSS 4.0.0",
      "http_client": "Axios 1.10.0"
    },
    "servicios_externos": {
      "almacenamiento": {
        "tipo": "AWS S3",
        "bucket": "cherry-fotos",
        "ruta_base": "shopify/{id}/{id}_{number}.jpg"
      },
      "api_externa": {
        "url": "https://cherryapi.estrategiadmgs.com.mx/cherryApi/789/articulos",
        "proposito": "Sincronización de productos"
      },
      "pagos": {
        "proveedor": "MercadoPago",
        "sdk": "mercadopago/dx-php 3.8"
      }
    }
  },
  "entidades_principales": [
    {
      "nombre": "Producto",
      "tabla": "productos",
      "pk": "id (string)",
      "campos_criticos": ["descripcion", "marca", "precio1-precio10", "fecha_alta", "opc_nuevo", "inventario", "stock_received_count", "id_linea", "catalogoId"],
      "relaciones": ["hasMany Detalle", "belongsTo Linea", "belongsToMany Catalog"]
    },
    {
      "nombre": "Detalle",
      "tabla": "detalles",
      "pk": "id (integer)",
      "campos_criticos": ["producto_id", "nombreColor", "detalle", "inventario_d"],
      "relaciones": ["belongsTo Producto"]
    },
    {
      "nombre": "User",
      "tabla": "users",
      "pk": "id",
      "campos_criticos": ["email", "password", "first_name", "last_name", "role_id", "seller_category", "credit_balance", "credit_limit"],
      "relaciones": ["hasMany Order", "hasMany Address", "hasMany Favorite", "hasMany Cart"]
    },
    {
      "nombre": "Order",
      "tabla": "orders",
      "pk": "id",
      "campos_criticos": ["user_id", "address_id", "total_amount", "subtotal", "discounted_total", "status", "payment_method", "mercadopago_preference_id"],
      "relaciones": ["belongsTo User", "belongsTo Address", "hasMany OrderItem"]
    },
    {
      "nombre": "OrderItem",
      "tabla": "order_items",
      "pk": "id",
      "campos_criticos": ["order_id", "product_id (string)", "color", "size", "quantity", "price"],
      "relaciones": ["belongsTo Order"]
    },
    {
      "nombre": "Cart",
      "tabla": "carts",
      "pk": "id",
      "campos_criticos": ["user_id"],
      "relaciones": ["belongsTo User", "hasMany CartItem"]
    },
    {
      "nombre": "CartItem",
      "tabla": "cart_items",
      "pk": "id",
      "campos_criticos": ["cart_id", "product_id", "color", "size", "quantity"],
      "relaciones": ["belongsTo Cart"]
    },
    {
      "nombre": "Catalog",
      "tabla": "catalogs",
      "pk": "id",
      "campos_criticos": ["name", "code", "image", "pdf_path"],
      "relaciones": ["belongsToMany Producto", "hasMany CatalogOffer"]
    },
    {
      "nombre": "CatalogOffer",
      "tabla": "catalog_offers",
      "pk": "id",
      "campos_criticos": ["catalog_id", "discount_percentage", "discount_category"],
      "relaciones": ["belongsTo Catalog"]
    },
    {
      "nombre": "UserOffer",
      "tabla": "user_offers",
      "pk": "id",
      "campos_criticos": ["user_id", "discount_percentage", "discount_category"],
      "relaciones": ["belongsTo User"]
    },
    {
      "nombre": "Address",
      "tabla": "addresses",
      "pk": "id",
      "campos_criticos": ["user_id", "street_address", "city", "state", "postal_code", "is_default"],
      "relaciones": ["belongsTo User"]
    },
    {
      "nombre": "Favorite",
      "tabla": "favorites",
      "pk": "id",
      "campos_criticos": ["user_id", "product_id (string)"],
      "relaciones": ["belongsTo User"]
    },
    {
      "nombre": "Review",
      "tabla": "reviews",
      "pk": "id",
      "campos_criticos": ["user_id", "product_id (string)", "rating", "comment", "is_approved"],
      "relaciones": ["belongsTo User"]
    },
    {
      "nombre": "Notification",
      "tabla": "notifications",
      "pk": "id",
      "campos_criticos": ["user_id", "message", "type", "read_at"],
      "relaciones": ["belongsTo User"]
    },
    {
      "nombre": "Historial",
      "tabla": "historials",
      "pk": "id",
      "campos_criticos": ["ejecutado_at", "estado", "mensaje"],
      "relaciones": []
    },
    {
      "nombre": "Category",
      "tabla": "categories",
      "pk": "id",
      "campos_criticos": ["name", "description"],
      "relaciones": []
    },
    {
      "nombre": "Linea",
      "tabla": "lineas",
      "pk": "id",
      "campos_criticos": ["name"],
      "relaciones": []
    },
    {
      "nombre": "Genero",
      "tabla": "generos",
      "pk": "id",
      "campos_criticos": ["name"],
      "relaciones": []
    },
    {
      "nombre": "Sector",
      "tabla": "sectores",
      "pk": "id",
      "campos_criticos": ["name"],
      "relaciones": []
    },
    {
      "nombre": "AffiliateBanner",
      "tabla": "affiliate_banners",
      "pk": "id",
      "campos_criticos": ["title", "subtitle", "button_text", "button_url", "image_path", "is_active", "display_order"],
      "relaciones": []
    },
    {
      "nombre": "AffiliateSeason",
      "tabla": "affiliate_seasons",
      "pk": "id",
      "campos_criticos": ["title", "button_url", "catalog_id", "image_path", "is_active", "display_order"],
      "relaciones": ["belongsTo Catalog", "hasMany AffiliateSeasonBox"]
    },
    {
      "nombre": "AffiliateSeasonBox",
      "tabla": "affiliate_season_boxes",
      "pk": "id",
      "campos_criticos": ["affiliate_season_id", "title", "description", "button_text", "button_url", "image_path", "is_active", "display_order"],
      "relaciones": ["belongsTo AffiliateSeason"]
    },
    {
      "nombre": "AffiliatePromoBanner",
      "tabla": "affiliate_promo_banners",
      "pk": "id",
      "campos_criticos": ["image_path", "button_url", "is_active", "display_order"],
      "relaciones": []
    },
    {
      "nombre": "AffiliateBottomBanner",
      "tabla": "affiliate_bottom_banners",
      "pk": "id",
      "campos_criticos": ["image_path", "button_url", "is_active", "display_order"],
      "relaciones": []
    },
    {
      "nombre": "AffiliateFaq",
      "tabla": "affiliate_faqs",
      "pk": "id",
      "campos_criticos": ["question", "answer", "display_order", "is_active"],
      "relaciones": []
    },
    {
      "nombre": "AffiliateTrend",
      "tabla": "affiliate_trends",
      "pk": "id",
      "campos_criticos": ["title", "button_url", "image_path", "is_active", "display_order"],
      "relaciones": []
    }
  ],
  "rutas_principales": {
    "autenticacion": [
      "POST /api/register",
      "POST /api/login",
      "POST /api/logout",
      "GET /api/me"
    ],
    "productos": [
      "GET /api/products/search?q=",
      "GET /api/products/new",
      "GET /api/products/coming-soon",
      "GET /api/products/{id}",
      "GET /api/top-selling"
    ],
    "carrito": [
      "GET /api/cart",
      "PUT /api/cart",
      "DELETE /api/cart",
      "POST /api/cart/sync"
    ],
    "pedidos": [
      "GET /api/orders",
      "POST /api/orders",
      "GET /api/orders/{id}"
    ],
    "direcciones": [
      "GET /api/addresses",
      "POST /api/addresses",
      "PUT /api/addresses/{id}",
      "DELETE /api/addresses/{id}"
    ],
    "favoritos": [
      "GET /api/favorites",
      "POST /api/favorites/toggle"
    ],
    "catalogos": [
      "GET /api/admin/catalogs",
      "GET /api/public/catalogs-with-images"
    ],
    "ofertas": [
      "GET /api/user-offers",
      "GET /api/user-offers/products"
    ],
    "historial": [
      "GET /api/admin/historial"
    ],
    "afiliacion_publica": [
      "GET /api/affiliate-content"
    ],
    "afiliacion_admin": [
      "CRUD /api/admin/affiliate-banners",
      "CRUD /api/admin/affiliate-seasons",
      "CRUD /api/admin/affiliate-seasons/{seasonId}/boxes",
      "CRUD /api/admin/affiliate-promo-banners",
      "CRUD /api/admin/affiliate-bottom-banners",
      "CRUD /api/admin/affiliate-faqs",
      "CRUD /api/admin/affiliate-trends"
    ]
  },
